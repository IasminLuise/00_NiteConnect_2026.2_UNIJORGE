{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nite-connect-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "NiteConnectApi",
      "image": "../../apps/api/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NITE_CONNECT_API",
        "class_name": "NiteConnectApi"
      }
    ]
  },
  "exports": {
    "NiteConnectApi": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ENTRA_ENABLED": "true"
  }
}
