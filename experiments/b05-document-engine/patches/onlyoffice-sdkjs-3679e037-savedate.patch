+AscWord.calculateSavedate = function(instruction, document, run)
+{
+	if (instruction.Unsupported)
+		return {ok: false, reason: "UNSUPPORTED_SWITCH"};
+
+	let core = document && document.Core;
+	let date = core && typeof core.asc_getModified === "function" ? core.asc_getModified() : null;
+	if (Object.prototype.toString.call(date) !== "[object Date]" || !Number.isFinite(date.getTime()))
+		return {ok: false, reason: "MISSING_LAST_SAVE"};
+
+	let directProperties = run && run.GetDirectTextPr ? run.GetDirectTextPr() : null;
+	let compiledProperties = run && run.Get_CompiledPr ? run.Get_CompiledPr(false) : null;
+	let directLanguage = directProperties && directProperties.Lang ? directProperties.Lang.Val : null;
+	let compiledLanguage = compiledProperties && compiledProperties.Lang ? compiledProperties.Lang.Val : null;
+	let runLanguage = directLanguage !== null && directLanguage !== undefined ? directLanguage : compiledLanguage;
+	let documentLanguage = document && document.GetDefaultLanguage ? document.GetDefaultLanguage() : null;
+	let candidates = [runLanguage, documentLanguage].filter(value => value !== null && value !== undefined);
+	let language = candidates.find(value => undefined !== AscCommon.g_aCultureInfos[value]);
+	if (undefined === language)
+	{
+		if (candidates.length)
+			return {ok: false, reason: "UNSUPPORTED_LANGUAGE"};
+		language = 1033;
+	}
+
+	let culture = AscCommon.g_aCultureInfos[language];
+	if (!culture)
+		return {ok: false, reason: "UNSUPPORTED_LANGUAGE"};
+
+	let picture = instruction.GetFormat();
+	if (!picture)
+	{
+		let day = AscCommon.getShortDateFormat(culture).replace(/m/g, "M").split("/").join(culture.DateSeparator || "/");
+		let clock = AscCommon.getLongTimeFormat(culture).split(";")[0];
+		if (!culture.UseAMPM)
+			clock = clock.replace(/h+/g, "HH");
+		picture = day + " " + clock;
+	}
+
+	let format = AscCommon.oNumFormatCache.get(picture, AscCommon.NumFormatType.WordFieldDate);
+	if (!format)
+		return {ok: false, reason: "UNSUPPORTED_PICTURE"};
+
+	let civil = Date.UTC(date.getFullYear(), date.getMonth(), date.getDate(), date.getHours(), date.getMinutes(), 0);
+	let serial = civil / 86400000 + 25569 - (civil < Date.UTC(1900, 2, 1) ? 1 : 0);
+	let value = format.formatToWord(serial, 15, culture);
+	if (typeof value !== "string" || !value)
+		return {ok: false, reason: "EMPTY_FORMATTED_RESULT"};
+
+	if (instruction.TextCase === "UPPER")
+		value = value.toLocaleUpperCase(culture.Name);
+	else if (instruction.TextCase === "LOWER")
+		value = value.toLocaleLowerCase(culture.Name);
+	else if (instruction.TextCase === "FIRSTCAP")
+		value = value.replace(/\p{L}/u, character => character.toLocaleUpperCase(culture.Name));
+	else if (instruction.TextCase === "CAPS")
+		value = value.replace(/\p{L}[\p{L}\p{M}]*/gu, word => word[0].toLocaleUpperCase(culture.Name) + word.slice(1).toLocaleLowerCase(culture.Name));
+
+	return {ok: true, value: value, language: language, picture: picture};
+};
